# Django Configuration
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=your-secret-key-here

# PostgreSQL Database Configuration
POSTGRES_USER=your_db_username
POSTGRES_DB=your_db_name
POSTGRES_PASSWORD=your_db_password

# (Optional) Cloudflare Workers AI model configuration.
# Worker reads this from Worker env bindings (for example wrangler.toml [vars]).
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
